# Environment Configuration Example
# Copy this file to .env and modify as needed

# Server Configuration
SERVER_PORT=8080
SERVER_HEARTBEAT_INTERVAL=30000
SERVER_MAX_MESSAGE_SIZE=1048576
SERVER_ENABLE_LOGGING=true

# Client Configuration (for examples)
CLIENT_URL=ws://localhost:8080
CLIENT_AUTO_RECONNECT=true
CLIENT_RECONNECT_INTERVAL=5000
CLIENT_MAX_RECONNECT_ATTEMPTS=5

# Logging Configuration
LOG_LEVEL=info
NODE_ENV=development
